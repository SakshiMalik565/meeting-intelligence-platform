# Database connection string (SQLite for local development)
DATABASE_URL=sqlite:///./fireflies.db

# Optional: LLM API key for generating real AI summaries.
# If left empty, the app falls back to a deterministic mock generator
# so the app is fully demoable without any external API key.
LLM_API_KEY=

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
